<?xml version="1.0" encoding="utf-8"?>
<!--
    The Camera tab: its main switch, pinned, then a preview of the swipe over your wallpaper,
    Open camera (or Close camera), and a note while the wallpaper is off. The ways out and the
    known limits are in its help, behind the top bar's ?.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <io.github.xiaomibutton.remapper.backscreen.ui.MainSwitchBar
        android:id="@+id/rear_mainSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/rear_camera_switch" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- The swipe, over what the back screen shows. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rear_previewCard"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:contentDescription="@string/rear_camera_preview"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:cardCornerRadius="28dp">

                <io.github.xiaomibutton.remapper.backscreen.wallpaper.RearPreviewLayout
                    android:id="@+id/rear_previewFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants">

                    <io.github.xiaomibutton.remapper.backscreen.wallpaper.WallpaperView
                        android:id="@+id/rear_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <io.github.xiaomibutton.remapper.backscreen.wallpaper.ClockLayer
                        android:id="@+id/rear_clock"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- The Edge glow's faint glow while charging, as on the back screen. -->
                    <io.github.xiaomibutton.remapper.backscreen.battery.ChargingLayer
                        android:id="@+id/rear_glow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <io.github.xiaomibutton.remapper.backscreen.camera.SwipeHint
                        android:id="@+id/rear_swipeHint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </io.github.xiaomibutton.remapper.backscreen.wallpaper.RearPreviewLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/rear_camera_caption"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <Button
                android:id="@+id/rear_openButton"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/rear_open_camera"
                app:icon="@drawable/rear_ic_camera" />

            <!-- Swiping needs the wallpaper: shown while it's off. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rear_wallpaperCard"
                style="@style/Widget.Remapper.RearCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rear_camera_wallpaper_off_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSecondaryContainer" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/rear_camera_wallpaper_off"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSecondaryContainer" />

                    <Button
                        android:id="@+id/rear_wallpaperButton"
                        style="@style/Widget.Material3.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/rear_turn_on_wallpaper"
                        app:icon="@drawable/rear_ic_image" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
